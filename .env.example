# ==============================================================================
# Environment Configuration - AI-Powered Restaurant Recommendation Engine
# ==============================================================================

# LLM Provider Configuration
# Choose: "gemini" or "openai"
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API Settings (Optional Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Model Hyperparameters
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1024

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Dataset Storage Paths
RAW_DATA_PATH=data/raw/zomato_raw.csv
PROCESSED_DATA_PATH=data/processed/zomato_clean.parquet

# Logging
LOG_LEVEL=INFO
