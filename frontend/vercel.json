{
  "rewrites": [
    { "source": "/static/:path*", "destination": "/:path*" },
    { "source": "/api/:path*", "destination": "https://RAILWAY_DOMAIN_HERE/api/:path*" },
    { "source": "/health", "destination": "https://RAILWAY_DOMAIN_HERE/health" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
